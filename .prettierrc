{
	"semi": false,
	"trailingComma": "es5",
	"singleQuote": true,
	"printWidth": 100,
	"tabWidth": 4,
	"useTabs": true,
	"arrowParens": "always",
	"endOfLine": "auto",
	"proseWrap": "preserve",
	"bracketSpacing": true,
	"overrides": [
		{
			"files": ["*.scss", "*.css"],
			"options": {
				"printWidth": 1000
			}
		}
	]
}
